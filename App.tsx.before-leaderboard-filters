function showMessage(title: string, message: string) {
  if (Platform.OS === 'web') {
    const browserAlert = (globalThis as any).alert;
    if (typeof browserAlert === 'function') {
      browserAlert(`${title}\n\n${message}`);
      return;
    }
  }

  Alert.alert(title, message);
}


